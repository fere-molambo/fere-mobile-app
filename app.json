{
  "expo": {
    "name": "fere",
    "slug": "fere",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fere",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Logo_fere2.png",
      "resizeMode": "contain",
      "backgroundColor": "#003f2f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.junior_molambo.fere"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#003f2f"
      },
      "package": "com.junior_molambo.fere",
      "splash": {
        "image": "./assets/images/Logo_fere2.png",
        "resizeMode": "contain",
        "backgroundColor": "#003f2f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-document-picker",
      "expo-notifications",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
