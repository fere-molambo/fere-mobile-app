{
  "expo": {
    "name": "fere",
    "slug": "fere",
    "version": "1.0.18",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fere",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Logo_fere2.png",
      "resizeMode": "contain",
      "backgroundColor": "#003f2f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juniormolambo.fere"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#003f2f"
      },
      "package": "com.junior_molambo.fere",
      "versionCode": 4,
      "splash": {
        "image": "./assets/images/Logo_fere2.png",
        "resizeMode": "contain",
        "backgroundColor": "#003f2f"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fere",
              "host": "payment"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      "expo-location",
      "expo-document-picker",
      "expo-notifications",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e67b6b72-52a5-4345-a121-4a7f3cc0b271"
      }
    }
  }
}
